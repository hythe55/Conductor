{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Conductor",
  "version": "0.1.10",
  "identifier": "io.github.hythe55.conductor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build && npm run build:host",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Conductor",
        "width": 1100,
        "height": 720,
        "minWidth": 420,
        "minHeight": 320,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http: https:; img-src 'self' data: blob:; media-src 'self' blob: mediastream:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Conductor contributors",
    "copyright": "GPL-3.0",
    "category": "Utility",
    "shortDescription": "Control your PCs from your other devices",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../target/release/conductor-host.exe": "conductor-host.exe",
      "../dist/": "web/"
    },
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "./installer.nsh",
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
